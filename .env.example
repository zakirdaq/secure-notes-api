# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Local Docker MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/secure_notes
# MongoDB Atlas (required if you deploy to Vercel):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

DB_NAME=secure_notes

# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=2h

BCRYPT_ROUNDS=12

PORT=3000
NODE_ENV=development

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Comma-separated browser origins of the frontend project (secure-notes-web).
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
